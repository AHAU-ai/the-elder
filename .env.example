# THE ELDER — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NEVER be committed.

# Required: your Anthropic API key
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: rate limit per visitor IP (per day)
# Default: 10 divinations per IP per 24 hours
RATE_LIMIT_PER_DAY=10

# Optional: max tokens per response
MAX_TOKENS=1200

# Required for saved-myth accounts (magic-link sign-in + myth memory):
# Neon Postgres connection string. Without it, auth/myth features no-op.
DATABASE_URL=postgres://user:password@host/db

# Required for saved-myth accounts: Resend API key for sending magic links.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your-key-here

# Required for saved-myth accounts: the "from" address for magic-link emails.
# Must be a verified sender/domain in Resend.
EMAIL_FROM=The Elder <elder@yourdomain.com>

# Required for saved-myth accounts: secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELDER_SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Required for the internal /altar/record diagnostic page (?key=<value>).
# Without this set, that route is unreachable (fails closed) rather than
# falling back to a guessable default.
ALTAR_SECRET=change-me-to-a-random-string

# Required: identifies which corpus snapshot grounds each Reading.
# /api/divine hard-fails (by design -- see src/resilience/provenance.ts)
# if this is unset, so every Reading can be traced to an exact corpus.
# Use a real snapshot id in deployment; any stable string is fine for local dev.
ELDER_CORPUS_VERSION=popol-wuj-vjs-2026.07.01

# Required for corpus ingestion (scripts-resilience/ingest.py): Voyage AI
# embeddings API key, used to embed approved+open passages into corpus_passage.
# Get one at https://dash.voyageai.com/api-keys
VOYAGE_API_KEY=pa-your-key-here

# Required only to regenerate the shareable-card marker landscapes
# (scripts/generate-marker-landscapes.mjs). Not needed to run the app --
# the generated images are checked into public/card-landscapes/ and served
# statically. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Required for the delayed Threshold Letter delivery sweep
# (app/api/cron/deliver-threshold-letters). Vercel Cron automatically
# sends this value as a Bearer token when a "crons" entry exists in
# vercel.json and this env var is set on the project -- the route fails
# closed (401) if it's unset, same posture as ELDER_SESSION_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change-me-to-a-random-64-char-hex-string

# Optional: absolute origin used to build links in the Threshold Letter
# delivery email (falls back to VERCEL_URL, then localhost:3000).
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# Required for app/api/admin/set-tier (§Tiered Membership manual tier
# grants -- see that route's own header comment for why this is a manual
# operator tool rather than a billing-provider webhook right now). Same
# shared-secret, fail-closed posture as CRON_SECRET above.
ADMIN_SECRET=change-me-to-a-random-64-char-hex-string

# Optional: overrides Council's annual price (cents) -- see
# config/entitlements.ts, spec's "leave configurable, not hardcoded" item.
# Falls back to 9900 ($99/year) if unset.
COUNCIL_ANNUAL_PRICE_CENTS=9900
