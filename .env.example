# THE ELDER — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NEVER be committed.

# Required: your Anthropic API key
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: rate limit per visitor IP (per day)
# Default: 10 divinations per IP per 24 hours
RATE_LIMIT_PER_DAY=10

# Optional: max tokens per response
MAX_TOKENS=1200

# Required for saved-myth accounts (magic-link sign-in + myth memory):
# Neon Postgres connection string. Without it, auth/myth features no-op.
DATABASE_URL=postgres://user:password@host/db

# Required for saved-myth accounts: Resend API key for sending magic links.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_your-key-here

# Required for saved-myth accounts: the "from" address for magic-link emails.
# Must be a verified sender/domain in Resend.
EMAIL_FROM=The Elder <elder@yourdomain.com>

# Required for saved-myth accounts: secret used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELDER_SESSION_SECRET=change-me-to-a-random-64-char-hex-string
